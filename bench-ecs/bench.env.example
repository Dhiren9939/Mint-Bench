# bench-ecs/make-env.sh writes bench.env (gitignored) from the Terraform outputs and copies it to the load generator
BASE_URL=https://mint-bench-ecs.dhiren.xyz
AWS_REGION=ap-south-1
TABLE=<dynamo table>
CLUSTER=<ecs cluster>
SERVICE=<ecs service>
MIN_TASKS=2
ENV_NAME=<env tag on the Mint cloudwatch metrics>
ALB=<alb arn suffix, app/...>
TG=<target group arn suffix, targetgroup/...>
CACHE1=<valkey member cluster id>
CACHE2=<valkey member cluster id>
