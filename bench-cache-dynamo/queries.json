[
  {
    "source": "db",
    "namespace": "AWS/DynamoDB",
    "dimensions": {
      "TableName": "{db}"
    },
    "metrics": [
      "ConsumedReadCapacityUnits",
      "ConsumedWriteCapacityUnits",
      "SuccessfulRequestLatency",
      "ReturnedItemCount",
      "ThrottledRequests",
      "ReadThrottleEvents",
      "WriteThrottleEvents",
      "SystemErrors",
      "UserErrors",
      "ConditionalCheckFailedRequests"
    ]
  },
  {
    "source": "cache-001",
    "namespace": "AWS/ElastiCache",
    "dimensions": {
      "CacheClusterId": "{cache}-001"
    },
    "metrics": [
      "CPUUtilization",
      "EngineCPUUtilization",
      "DatabaseMemoryUsagePercentage",
      "CurrConnections",
      "NewConnections",
      "NetworkBytesIn",
      "NetworkBytesOut",
      "CacheHits",
      "CacheMisses",
      "GetTypeCmds",
      "SetTypeCmds",
      "EvalBasedCmds"
    ]
  },
  {
    "source": "cache-002",
    "namespace": "AWS/ElastiCache",
    "dimensions": {
      "CacheClusterId": "{cache}-002"
    },
    "metrics": [
      "CPUUtilization",
      "EngineCPUUtilization",
      "DatabaseMemoryUsagePercentage",
      "CurrConnections",
      "NetworkBytesIn",
      "NetworkBytesOut",
      "ReplicationLag"
    ]
  },
  {
    "source": "backend",
    "namespace": "Mint",
    "dimensions": {
      "env": "bench-cache-dynamo"
    },
    "metrics": [
      "mint.cache.get.count",
      "mint.cache.get.sum",
      "mint.cache.get.avg",
      "mint.cache.get.max",
      "mint.cache.get.percentile",
      "mint.cache.put.count",
      "mint.cache.put.sum",
      "mint.cache.put.avg",
      "mint.cache.put.max",
      "mint.cache.put.percentile",
      "mint.db.duration.count",
      "mint.db.duration.sum",
      "mint.db.duration.avg",
      "mint.db.duration.max",
      "mint.db.duration.percentile",
      "mint.ratelimit.duration.count",
      "mint.ratelimit.duration.sum",
      "mint.ratelimit.duration.avg",
      "mint.ratelimit.duration.max",
      "mint.ratelimit.duration.percentile",
      "mint.ratelimit.decisions",
      "mint.redis.connected",
      "http.server.requests.count",
      "http.server.requests.sum",
      "http.server.requests.avg",
      "http.server.requests.max",
      "http.server.requests.percentile",
      "tomcat.threads.busy",
      "tomcat.threads.config.max",
      "tomcat.connections.current",
      "tomcat.connections.max",
      "jvm.threads.live",
      "jvm.gc.pause.count",
      "jvm.gc.pause.sum",
      "jvm.gc.pause.max",
      "process.cpu.usage",
      "system.cpu.usage",
      "jvm.memory.used",
      "jvm.memory.max"
    ]
  }
]
