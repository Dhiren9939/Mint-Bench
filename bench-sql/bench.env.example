# copy to bench.env (gitignored) on the load generator and fill it in, start.sh and after.sh read it
BACKEND=admin@<backend public ip>
DB_HOST=<rds address, no port>
DB_USERNAME=<db user>
DB_PASSWORD=<db password>
SSH_KEY=~/mintkey.pem
BACKEND_ID=<backend instance id>
DB_ID=<rds identifier, the first part of the address>
