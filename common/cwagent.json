{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "metrics": {
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    },
    "metrics_collected": {
      "cpu": {
        "measurement": ["cpu_usage_user", "cpu_usage_system", "cpu_usage_idle", "cpu_usage_iowait", "cpu_usage_steal"],
        "totalcpu": true
      },
      "mem": {
        "measurement": ["mem_used_percent", "mem_used", "mem_available"]
      },
      "swap": {
        "measurement": ["swap_used_percent"]
      },
      "disk": {
        "measurement": ["used_percent", "used", "free"],
        "resources": ["/"]
      },
      "diskio": {
        "measurement": ["reads", "writes", "read_bytes", "write_bytes", "iops_in_progress"],
        "resources": ["*"]
      },
      "net": {
        "measurement": ["bytes_sent", "bytes_recv"],
        "resources": ["*"]
      },
      "netstat": {
        "measurement": ["tcp_established", "tcp_time_wait"]
      },
      "procstat": [
        { "exe": "java", "measurement": ["cpu_usage", "memory_rss"] },
        { "exe": "redis-server", "measurement": ["cpu_usage", "memory_rss"] },
        { "exe": "dockerd", "measurement": ["cpu_usage", "memory_rss"] },
        { "exe": "containerd", "measurement": ["cpu_usage", "memory_rss"] },
        { "exe": "amazon-cloudwatch-agent", "measurement": ["cpu_usage", "memory_rss"] }
      ]
    }
  }
}
